{
  "schemaVersion": 1,
  "id": "dupeclient",
  "version": "${version}",
  "name": "DupeClient",
  "description": "Fabric client mod with in-game module hub, DupeDB integration, packet tools, macros, and security features.",
  "authors": [
    "DupeClient"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.dupeclient.client.DupeClient",
      "com.ui_utils.MainClient"
    ]
  },
  "mixins": [
    "dupeclient.mixins.json",
    "dupeclient_ui_utils.mixins.json"
  ],
  "accessWidener": "ui_utils.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "baritone-meteor": "*"
  }
}
